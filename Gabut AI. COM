      `;
    }

    function appendDemoBubble(role, text, imageUrl = null) {
      const row = document.createElement('div');
      row.className = role === 'user' ? 'flex justify-end' : 'flex items-start gap-3';

      if (role === 'user') {
        const bubble = document.createElement('div');
        bubble.className = 'bg-brand text-white rounded-2xl rounded-tr-sm px-4 py-2.5 max-w-[85%] text-sm space-y-2 shadow';

        if (imageUrl) {
          const img = document.createElement('img');
          img.src = imageUrl;
          img.alt = 'Gambar kiriman';
          img.className = 'rounded-xl max-h-52 w-auto object-contain border border-white/20';
          bubble.appendChild(img);
        }

        if (text) {
          const txt = document.createElement('div');
          txt.className = 'leading-relaxed break-words';
          txt.innerHTML = formatDemoMarkdown(text);
          bubble.appendChild(txt);
        }

        row.appendChild(bubble);
      } else {
        const avatar = document.createElement('div');
        avatar.className = 'w-8 h-8 rounded-xl bg-gradient-to-tr from-brand to-cyanGlow flex items-center justify-center text-sm shrink-0 mt-0.5';
        avatar.textContent = '🗿';

        const bubble = document.createElement('div');
        bubble.className = 'bg-panel border border-slate-800 rounded-2xl rounded-tl-sm px-4 py-3 max-w-[85%] text-sm text-slate-200 space-y-1';

        const label = document.createElement('div');
        label.className = 'text-xs font-semibold text-cyan-300';
        label.textContent = 'Gabut AI';

        const body = document.createElement('div');
        body.className = 'leading-relaxed break-words';
        body.innerHTML = formatDemoMarkdown(text);

        bubble.appendChild(label);
        bubble.appendChild(body);
        row.appendChild(avatar);
        row.appendChild(bubble);
      }

      demoChatMessages.appendChild(row);
      demoChatMessages.scrollTop = demoChatMessages.scrollHeight;
    }

    function showDemoTyping() {
      const el = document.createElement('div');
      el.id = 'demoTyping';
      el.className = 'flex items-start gap-3';
      el.innerHTML = `
        <div class="w-8 h-8 rounded-xl bg-gradient-to-tr from-brand to-cyanGlow flex items-center justify-center text-sm shrink-0 mt-0.5">🗿</div>
        <div class="bg-panel border border-slate-800 rounded-2xl rounded-tl-sm px-4 py-3">
          <div class="text-xs font-semibold text-cyan-300 mb-1">Gabut lagi mikir...</div>
          <div class="flex items-center gap-1.5 h-3.5">
            <span class="typing-dot w-2 h-2 rounded-full bg-cyan-400"></span>
            <span class="typing-dot w-2 h-2 rounded-full bg-cyan-400"></span>
            <span class="typing-dot w-2 h-2 rounded-full bg-cyan-400"></span>
          </div>
        </div>
      `;
      demoChatMessages.appendChild(el);
      demoChatMessages.scrollTop = demoChatMessages.scrollHeight;
    }

    function removeDemoTyping() {
      const el = document.getElementById('demoTyping');
      if (el) el.remove();
    }

    function clearDemoImage() {
      demoSelectedImage = null;
      demoImageInput.value = '';
      demoImagePreview.src = '';
      demoImagePreviewWrap.classList.add('hidden');
      demoImagePreviewWrap.classList.remove('flex');
    }

    demoImageInput.addEventListener('change', (e) => {
      const file = e.target.files?.[0];
      if (!file) return;
      if (!file.type.startsWith('image/')) {
        showDemoError('File harus berupa gambar ya!');
        return;
      }
      if (file.size > 6 * 1024 * 1024) {
        showDemoError('Ukuran foto maksimal 6MB ya.');
        return;
      }
      const reader = new FileReader();
      reader.onload = () => {
        const dataUrl = reader.result;
        demoSelectedImage = {
          base64: dataUrl.split(',')[1],
          mimeType: file.type,
          dataUrl
        };
        demoImagePreview.src = dataUrl;
        demoImageName.textContent = file.name;
        demoImagePreviewWrap.classList.remove('hidden');
        demoImagePreviewWrap.classList.add('flex');
        hideDemoError();
      };
      reader.readAsDataURL(file);
    });

    removeDemoImageBtn.addEventListener('click', clearDemoImage);

    function openAppModal() {
      mobileNavMenu.classList.add('hidden');
      appModal.classList.remove('hidden');
      appModal.classList.add('flex');
      if (demoChatMessages.children.length === 0) {
        renderDemoWelcome();
      }
      demoUserInput.focus();
    }

    function closeAppModal() {
      appModal.classList.add('hidden');
      appModal.classList.remove('flex');
    }

    openAppButtons.forEach((btn) => btn.addEventListener('click', openAppModal));
    closeAppModalBtn.addEventListener('click', closeAppModal);

    appModal.addEventListener('click', (e) => {
      if (e.target === appModal) closeAppModal();
    });

    resetDemoChatBtn.addEventListener('click', () => {
      if (isDemoLoading) return;
      demoHistory = [];
      clearDemoImage();
      hideDemoError();
      renderDemoWelcome();
    });

    demoChips.forEach((chip) => {
      chip.addEventListener('click', () => {
        if (isDemoLoading) return;
        demoUserInput.value = chip.getAttribute('data-demo-prompt');
        demoChatForm.dispatchEvent(new Event('submit'));
      });
    });

    demoUserInput.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' && !e.shiftKey) {
        e.preventDefault();
        demoChatForm.dispatchEvent(new Event('submit'));
      }
    });

    async function fetchGabutReply(contents) {
      const url = `https://generativelanguage.googleapis.com/v1beta/models/${MODEL_NAME}:generateContent?key=${apiKey}`;
      let delay = 1000;
      for (let attempt = 0; attempt <= 4; attempt++) {
        try {
          const response = await fetch(url, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              contents,
              systemInstruction: {
                parts: [{ text: GABUT_SYSTEM_PROMPT }]
              }
            })
          });
          if (!response.ok) {
            if ((response.status === 429 || response.status >= 500) && attempt < 4) {
              await new Promise((r) => setTimeout(r, delay));
              delay *= 2;
              continue;
            }
            throw new Error(`HTTP ${response.status}`);
          }
          const result = await response.json();
          const text = result?.candidates?.[0]?.content?.parts?.[0]?.text;
          if (!text) throw new Error('Respons kosong');
          return text;
        } catch (err) {
          if (attempt === 4) throw err;
          await new Promise((r) => setTimeout(r, delay));
          delay *= 2;
        }
      }
    }

    demoChatForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (isDemoLoading) return;

      const text = demoUserInput.value.trim();
      const attached = demoSelectedImage ? { ...demoSelectedImage } : null;
      if (!text && !attached) return;

      hideDemoError();
      isDemoLoading = true;
      demoSendBtn.disabled = true;
      demoUserInput.value = '';
      clearDemoImage();

      appendDemoBubble('user', text, attached?.dataUrl || null);

      const userParts = [];
      if (text) {
        userParts.push({ text });
      } else {
        userParts.push({ text: 'Lihat foto ini dan beri komentar santai yang seru!' });
      }
      if (attached) {
        userParts.push({
          inlineData: {
            mimeType: attached.mimeType,
            data: attached.base64
          }
        });
      }

      demoHistory.push({ role: 'user', parts: userParts });
      showDemoTyping();

      try {
        const reply = await fetchGabutReply(demoHistory);
        removeDemoTyping();
        demoHistory.push({ role: 'model', parts: [{ text: reply }] });
        appendDemoBubble('model', reply);
      } catch {
        removeDemoTyping();
        demoHistory.pop();
        showDemoError('Waduh, koneksi ke server AI lagi gangguan. Coba kirim ulang sebentar lagi ya!');
      } finally {
        isDemoLoading = false;
        demoSendBtn.disabled = false;
        demoUserInput.focus();
      }
    });
  </script>
